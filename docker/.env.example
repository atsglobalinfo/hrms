# Copy this file to .env on each machine (local dev or the production server) and fill in
# real values. .env is gitignored — never commit real passwords.

MARIADB_ROOT_PASSWORD=changeme
ADMIN_PASSWORD=changeme
DEVELOPER_MODE=0

# Production site domain (use hrms.localhost for local dev)
SITE_NAME=hrms.atsglobal.in

# Point at your fork so custom migration script + branding are included.
# For local dev without the fork, just use "hrms" (pulls the stock frappe/hrms app).
HRMS_APP_SOURCE=https://github.com/atsglobalinfo/atsglobal-hrms.git
HRMS_APP_BRANCH=develop

# eSSL ADMS Receiver
ESSL_API_KEY=your_frappe_api_key
ESSL_API_SECRET=your_frappe_api_secret
ESSL_DEVICE_ID=eSSL-x2008
ESSL_IN_DEVICE_SN=6426144200014
ESSL_OUT_DEVICE_SN=
